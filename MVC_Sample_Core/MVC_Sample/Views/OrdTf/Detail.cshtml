@*
    //**********************************************************************************
    //* サンプル アプリ・モデル
    //**********************************************************************************

    //**********************************************************************************
    //* クラス名        ：Detail
    //* クラス日本語名  ：受注詳細・照会（SC-ORD-02）
    //*
    //* 作成日時        ：2026/11/24
    //* 作成者          ：実装役
    //* 更新履歴        ：
    //*
    //*  日時        更新者            内容
    //*  ----------  ----------------  -------------------------------------------------
    //*  2026/11/24  実装役            Red 用の空の土台（段 2。画面の要素は段 4 で実装する）
    //*  2026/11/24  実装役            実装（段 4。EV-ORD-201・203。メインボタンは削除だけ。決定 4）
    //**********************************************************************************
*@

@using System.Globalization
@using MVC_Sample.Models.ViewModels
@using WSIFType_sample
@model OrdTfDetailViewModel

@{
    // ページタイトル
    ViewBag.Title = "受注詳細";
    CultureInfo inv = CultureInfo.InvariantCulture;
    OrdTfReturnValue d = Model.Data;
    string msgClass = string.IsNullOrEmpty(Model.Message) ? "" : (Model.MessageIsError ? "text-danger" : "text-info");

    // 表示の書式（共通仕様 3・4 節）：日付 yyyy/MM/dd、金額は千区切り＋小数 2 桁（小数第 3 位を四捨五入）、NULL は空
    string Date(DateTime? v) { return v.HasValue ? v.Value.ToString("yyyy/MM/dd", inv) : ""; }
    string Money(decimal? v) { return v.HasValue ? Math.Round(v.Value, 2, MidpointRounding.AwayFromZero).ToString("#,##0.00", inv) : ""; }
    // 割引率は百分率（0.15 → 15%。端数があれば小数で 12.5%。DEC-ORD-25）
    string Percent(decimal v) { return (v * 100m).ToString("0.##", inv) + "%"; }
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
}

@* フッタ部のメインボタン（5 つ）。@section は <form> の外に描画されるので form 属性で紐付ける。
   機能トランザクションを起動するのは削除だけ。編集（画面上部）・一覧へ戻る（画面下部）は遷移だけなのでメインボタンに含めない（決定 4） *@
@section FooterButtonsSection{
    <button type="submit" id="btnMain1" class="btn btn-danger" form="OrdTfDeleteForm"
            onclick="return window.confirm('受注 ID @(d.OrderID) を削除します。よろしいですか？');">削除</button>
    @for (int i = 2; i <= 5; i++)
    {
        <button type="button" id="@("btnMain" + i)" class="btn btn-secondary" disabled="disabled"></button>
    }
}

@* 本文レイアウト（RenderBodyに出力されます） *@
<form id="OrdTfDeleteForm" method="post" action="@Url.Action("Delete")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@d.OrderID" />
    <input type="hidden" name="rowVersion" value="@d.RowVersion" />
</form>

@* 共通メッセージ領域（エラーは text-danger、情報は text-info） *@
<div id="messageArea" class="@msgClass">@Model.Message</div>

@* 編集（B01。画面上部。出荷済のときは非活性。ORD-T4。押したときの振る舞いは次の回） *@
<div class="mb-2">
    <button type="button" id="btnEdit" class="btn btn-primary" disabled="@(!d.CanEdit)">編集</button>
</div>

@* 受注情報（SC-ORD-02-I01〜I10） *@
<table class="table table-sm table-bordered">
    <tr><th>受注 ID</th><td id="orderId">@d.OrderID</td><th>状況</th><td id="status">@d.Status</td></tr>
    <tr><th>顧客名</th><td id="customerName">@d.CustomerName</td><th>顧客電話番号</th><td id="customerPhone">@d.CustomerPhone</td></tr>
    <tr><th>顧客住所</th><td id="customerAddress" colspan="3">@d.CustomerAddress</td></tr>
    <tr><th>担当者名</th><td id="employeeName">@d.EmployeeName</td><th>配送業者</th><td id="shipperName">@d.ShipperName</td></tr>
    <tr><th>受注日</th><td id="orderDate">@Date(d.OrderDate)</td><th>要求納期</th><td id="requiredDate">@Date(d.RequiredDate)</td></tr>
    <tr><th>出荷日</th><td id="shippedDate">@Date(d.ShippedDate)</td><td colspan="2"></td></tr>
</table>

@* 出荷先情報（SC-ORD-02-I11〜I16） *@
<table class="table table-sm table-bordered">
    <tr><th>出荷先名称</th><td id="shipName">@d.ShipName</td><th>出荷先住所</th><td id="shipAddress">@d.ShipAddress</td></tr>
    <tr><th>出荷先市区町村</th><td id="shipCity">@d.ShipCity</td><th>出荷先地域</th><td id="shipRegion">@d.ShipRegion</td></tr>
    <tr><th>出荷先郵便番号</th><td id="shipPostalCode">@d.ShipPostalCode</td><th>出荷先国</th><td id="shipCountry">@d.ShipCountry</td></tr>
</table>

@* 受注明細情報（SC-ORD-02-I17〜I20）。一覧は table を自前で生成し、tr をループする *@
<table id="detailList" class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>商品名</th>
            <th>単価</th>
            <th>割引率</th>
            <th>価格</th>
            <th>数量</th>
            <th>在庫</th>
            <th>明細金額</th>
        </tr>
    </thead>
    <tbody>
        @foreach (OrdTfDetailLine line in d.Lines)
        {
            <tr>
                <td>@line.ProductName</td>
                <td>@Money(line.UnitPrice)</td>
                <td>@Percent(line.Discount)</td>
                <td>@Money(line.Price)</td>
                <td>@line.Quantity</td>
                <td>@(line.UnitsInStock.HasValue ? line.UnitsInStock.Value.ToString(inv) : "")</td>
                <td>@Money(line.Amount)</td>
            </tr>
        }
    </tbody>
</table>
<table class="table table-sm table-bordered w-auto">
    <tr><th>小計</th><td id="subtotal" class="text-end">@Money(d.Subtotal)</td></tr>
    <tr><th>送料</th><td id="freight" class="text-end">@Money(d.Freight)</td></tr>
    <tr><th>合計</th><td id="total" class="text-end fw-bold">@Money(d.Total)</td></tr>
</table>

@* 一覧へ戻る（B06。画面下部。保持された一覧状態を復元する。EV-ORD-206） *@
<div class="mt-2">
    <a id="btnBack" class="btn btn-secondary" href="@Url.Action("Back")">一覧へ戻る</a>
</div>

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
}
